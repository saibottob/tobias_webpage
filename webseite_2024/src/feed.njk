---
permalink: /feed.xml
layout: false
eleventyExcludeFromCollections: true
sitemap: false
eleventyImport:
  collections:
    - blog
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.language }}">
  <title>{{ site.feedTitle }}</title>
  <subtitle>{{ site.feedSubtitle }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ collections.blog | feedUpdated | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  {%- for post in collections.blog %}
  {%- set absolutePostUrl = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <id>{{ absolutePostUrl }}</id>
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ post | modifiedDate | dateToRfc3339 }}</updated>
    {%- if post.data.kategorie %}
    <category term="{{ post.data.kategorie | displayCategory }}"/>
    {%- endif %}
    {%- if post.data.description %}
    <summary type="text">{{ post.data.description }}</summary>
    {%- endif %}
    <content type="html">{{ post.content | renderTransforms(post.data.page, site.url + "/") }}</content>
  </entry>
  {%- endfor %}
</feed>
